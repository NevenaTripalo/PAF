#Za oba skupa podataka izračunajte sve tri veličine i odgovorite na pitanja:
#(a) Kako se mijenja s kada povećamo broj mjerenja, a kako σ¯x?
#(b) Kolika je relativna razlika između σn i s za mali, a kolika za veliki skup?
#(c) np.std() po defaultu dijeli s n, kada je to ispravno koristiti?

import numpy as np
import statistics as stats
# 5 mjerenja temperature vrenja vode [u stupnjevima Celzijusa]
malo_n = [99.8, 100.1, 99.9, 100.2, 100.0]
# 10000 mjerenja istog eksperimenta (simulacija)
np.random.seed(42)
veliko_n = np.random.normal(loc=100.0, scale=0.2, size=10000).tolist()
#generira slucajne brojeve iz gaussove distribucije, loc je srednja vrijednost
#scale je standardna devijacija
#size je koliko mjerenja se  obavlja i .tolist pretvara np array u listu

# 1) σ_n — populacijska standardna devijacija (dijeli se s n)
def sigma_n(lista):
    data = np.array(lista)
    srednja = np.mean(data)
    return np.sqrt(np.sum((data - srednja)**2) / len(data))

# 2) s — uzorkovna standardna devijacija (dijeli se s n-1)
def s(lista):
    data = np.array(lista)
    srednja = np.mean(data)
    return np.sqrt(np.sum((data - srednja)**2) / (len(data) - 1))

# 3) σ̄x = s/√n — standardna pogreška srednje vrijednosti
def sigma_srednje(lista):
    return s(lista) / np.sqrt(len(lista))

def relativna_razlika(lista):
    sig_n = sigma_n(lista)
    s_val = s(lista)
    return abs(s_val - sig_n) / sig_n * 100


# ispis rezultata

print("MALI SKUP (n = 5):")
print("sigma_n =", sigma_n(malo_n))
print("s =", s(malo_n))
print("sigma_x =", sigma_srednje(malo_n))
print("Relativna razlika =", relativna_razlika(malo_n), "%")
print()
print("VELIKI SKUP (n = 10000):")
print("sigma_n =", sigma_n(veliko_n))
print("s =", s(veliko_n))
print("sigma_x =", sigma_srednje(veliko_n))
print("Relativna razlika =", relativna_razlika(veliko_n), "%")
